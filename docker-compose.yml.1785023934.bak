services:
  arkime1-capture:
    image: arkime/arkime:latest
    command: capture
    env_file:
    - arkime.env
    restart: unless-stopped
    volumes:
    - /arkime/etc:/opt/arkime/etc
    - /arkime/pcap:/opt/arkime/raw
    - /arkime/maxmind:/var/lib/GeoIP
    - './GeoIP.conf:/etc/GeoIP.conf'
    network_mode: host
    cap_add:
    - NET_ADMIN
    - NET_RAW
    depends_on:
    - elasticsearch
  arkime2-viewer:
    image: arkime/arkime:latest
    command: viewer
    env_file:
    - arkime.env
    restart: unless-stopped
    volumes:
    - /arkime/etc:/opt/arkime/etc
    - /arkime/pcap:/opt/arkime/raw
    - /arkime/maxmind:/var/lib/GeoIP
    - './GeoIP.conf:/etc/GeoIP.conf'
    network_mode: host
    depends_on:
    - elasticsearch
  wise:
    image: arkime/arkime:latest
    command: wise
    env_file:
    - arkime.env
    restart: unless-stopped
    volumes:
    - /arkime/etc:/opt/arkime/etc
    ports:
    - '8081:8081'
    depends_on:
    - elasticsearch
  arkime-parliament:
    image: arkime/arkime:latest
    command: parliament
    env_file:
    - arkime.env
    restart: unless-stopped
    volumes:
    - /arkime/etc:/opt/arkime/etc
    ports:
    - '8008:8008'
    depends_on:
    - elasticsearch
  arkime-cont3xt:
    image: arkime/arkime:latest
    command: cont3xt
    env_file:
    - arkime.env
    restart: unless-stopped
    volumes:
    - /arkime/etc:/opt/arkime/etc
    ports:
    - '3218:3218'
    depends_on:
    - elasticsearch
  elasticsearch:
    container_name: elasticsearch
    image: elasticsearch:8.19.19
    network_mode: host
    environment:
    - discovery.type=single-node
    - xpack.security.enabled=false
    - xpack.security.enrollment.enabled=false
    - xpack.security.transport.ssl.enabled=false
    - xpack.security.http.ssl.enabled=false
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
    - /arkime/esdata:/usr/share/elasticsearch/data
    restart: unless-stopped
